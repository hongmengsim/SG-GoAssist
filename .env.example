EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Server-only LTA DataMall credential used by the backend sync command.
LTA_DATAMALL_ACCOUNT_KEY=
# Optional: override the standards-compliant OpenStreetMap tile endpoint used on Web.
EXPO_PUBLIC_MAP_TILE_URL=
# Optional: openrouteservice key for its dedicated `wheelchair` profile.
# When omitted, Web uses the public FOSSGIS Valhalla service with
# `transport_type: wheelchair`; it never falls back silently to walking.
EXPO_PUBLIC_OPENROUTESERVICE_API_KEY=
# Optional: override the Valhalla wheelchair-routing endpoint.
EXPO_PUBLIC_WHEELCHAIR_ROUTING_URL=https://valhalla1.openstreetmap.de/route
# Native Google Maps only; Expo Web does not read or require this value.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Persisted case state and append-only audit events. Defaults to .runtime/.
GOASSIST_DATA_DIR=
# Optional: `sqlite` or `memory` forces that storage even when GOASSIST_DATABASE_URL is set.
# (`json` was the old no-SQLite mode; it now means memory, and data is then lost on restart.)
GOASSIST_STORAGE_DRIVER=
# Optional HMAC secret shared by provisioned stop and vehicle demo controllers.
DEVICE_SHARED_SECRET=
# Optional bearer token for operator-only APIs and WebSocket monitoring.
OPERATOR_API_TOKEN=
# Maximum accepted age of safety telemetry before actuation is blocked.
GOASSIST_TELEMETRY_FRESHNESS_MS=5000

# ---- Running more than one backend process (see docs/runbooks/multi-process.md) ----
# Postgres instead of SQLite. Contains a password: keep it in the environment, never commit it.
# Needs the pg package: npm install --no-save --workspace @buspass/backend pg
GOASSIST_DATABASE_URL=
# memory (default, one process) or redis. redis needs GOASSIST_REDIS_URL and the ioredis package.
GOASSIST_EVENT_BUS=
GOASSIST_REDIS_URL=
# memory (default) or database: share locks between processes through the database.
GOASSIST_LOCKS=
# Lock lease length and how long to wait for a lock, in milliseconds (defaults 15000 and 10000).
GOASSIST_LOCK_TTL_MS=
GOASSIST_LOCK_TIMEOUT_MS=

# ---- Retention: how much finished-case and series data is kept (placeholders, not agreed values) ----
GOASSIST_RETENTION_CASE_DAYS=7
GOASSIST_RETENTION_MAX_FINISHED_CASES=2000
GOASSIST_RETENTION_MAX_SERIES_RECORDS=5000

# ---- Which route sets this process serves: passenger, operations, or both (default) ----
GOASSIST_ROLES=
