const s=slide('Alternatives and selected method',timed(40,'Compare design tradeoffs, not measured impact. Manual assistance provides an operator baseline. Camera-only triggering cannot establish consent. Explain why explicit intent with perception and deterministic checks is the selected prototype method.',outline+', pp. 2, 5–9, 13. Comparison is the team design rationale, not a completed experimental comparison.'));table(s,[['Approach','Useful feature','Tradeoff / design decision'],['Manual assistance','Human judgement and flexible intervention','Use as the baseline. It requires an operator to coordinate each journey.'],['Camera-only trigger','Observable assistance cues without app input','A cue cannot establish a request or consent. Reject as ramp authority.'],['Explicit request with sensor checks','Passenger control plus verified system response','Selected method. Adds integration and calibration work.']],[290,360,498],187,386,24);text(s,'ML interprets uncertain scenes. Fixed rules and physical sensors retain safety vetoes.',66,609,1135,61,27,C.teal,true);}
{
