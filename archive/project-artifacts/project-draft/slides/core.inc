const s=slide('Problem and project objective',timed(30,'Explain that requests must lead to understandable, verified assistance. Include passengers who ask for extra time or guidance without a visible mobility aid. State the controlled-prototype boundary.',outline+', pp. 1–3, 13.'),'A controlled prototype for accessible boarding and alighting');paras(s,[['Passenger need','A clear way to request help and understand when boarding or alighting can proceed.'],['Project objective','Complete one repeatable journey from explicit request to acknowledgement, safe assistance and verified completion.'],['Inclusive scope','Ramp assistance, extra time and audio, visual or haptic guidance based on the passenger’s choice.']],66,208,1148,124);}
