# Backend Configuration
# The full list, including storage, event bus, locks and retention, is in the repository root .env.example
# and in backend/README.md.

# Server
PORT=3000
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# WebSocket
WS_PORT=3001

# Logging
LOG_LEVEL=debug
