    "expo-build-properties": "~56.0.27",
    "expo-camera": "~56.0.8",
    "expo-dev-client": "~56.0.26",
    "expo-device": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-location": "~56.0.25",
    "expo-speech": "~56.0.3",
    "expo-speech-recognition": "^57.0.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "llama.rn": "^0.12.4",
    "lucide-react-native": "^1.38.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "0.85.3",
