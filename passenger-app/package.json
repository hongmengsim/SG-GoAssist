    "@types/leaflet": "1.9.20",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~56.0.0",
    "dotenv": "^16.6.1",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
