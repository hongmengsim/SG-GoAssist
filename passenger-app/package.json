    "lint": "npm run typecheck",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@buspass/shared": "0.1.0",
    "@expo/metro-runtime": "~56.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
